From 01c9a64bda60f07a8715e9e9ed321068baa8c68e Mon Sep 17 00:00:00 2001
From: Jeff Cooper <repoocaj@gmail.com>
Date: Tue, 5 May 2026 12:12:27 -0500
Subject: [PATCH 4/4] Add function to close open flash log file

---
 subsys/logging/backends/log_backend_fs.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/subsys/logging/backends/log_backend_fs.c b/subsys/logging/backends/log_backend_fs.c
index 91b0b910d83..93be5e52946 100644
--- a/subsys/logging/backends/log_backend_fs.c
+++ b/subsys/logging/backends/log_backend_fs.c
@@ -523,3 +523,11 @@ void log_backend_fs_force_cycle(void)
     /* Set the flag to force a file cycle. */
     force_cycle = true;
 }
+
+void log_backend_fs_teardown(void)
+{
+    if (backend_state == BACKEND_FS_OK) {
+        fs_close(&fs_file);
+    }
+    backend_state = BACKEND_FS_NOT_INITIALIZED;
+}
\ No newline at end of file
